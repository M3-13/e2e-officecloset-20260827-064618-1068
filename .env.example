# Copy this file to .env (or export the variables in your shell) and adjust.
# The product boots without any of these, but set them to get stable values.

# Database connection URL (SQLite dev default).
DATABASE_URL=sqlite:///./dev.db

# JWT signing secret. Generate a random one, e.g.:
#   py -c "import secrets; print(secrets.token_hex(32))"
# Leave unset to have the app roll a fresh one per process.
JWT_SECRET=

# Token lifetime in minutes (max 15).
JWT_EXPIRES_MINUTES=15

# Allowed frontend origin for CORS.
CORS_ORIGIN=http://localhost:5173
